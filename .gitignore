# Generated data -- every file here is reproducible by running the project's
# own generator with its fixed seed. Committing it would add megabytes and
# invite the reader to trust a file instead of the script that made it.
data/
*.parquet
*.db
*.db-wal
*.db-shm
warehouse.db
drift.db

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# HMDA extract: 11.6MB of public CFPB data, reproducible from the URL in
# src/hmda.py. Committing it would put a copy of a public dataset in a git
# repo and invite the reader to trust the copy rather than the source.
data/hmda_*.csv
